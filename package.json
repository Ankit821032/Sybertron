{
  "name": "sybertron-cms",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:all": "npm run dev",
    "build": "tsx scripts/content-library.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "preview": "npm start",
    "format": "oxfmt",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "admin:create": "node --env-file-if-exists=.env --import tsx server/create-admin.ts",
    "dev:client": "vite"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
